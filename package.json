{
  "name": "yamusic-downloader-pro",
  "private": true,
  "scripts": {
    "start": "node --env-file=.env.local server/index.mjs",
    "configure": "node scripts/setup.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test server/tests/*.test.mjs",
    "service:install": "node scripts/service.mjs install",
    "service:status": "node scripts/service.mjs status",
    "service:restart": "node scripts/service.mjs restart",
    "service:uninstall": "node scripts/service.mjs uninstall"
  },
  "dependencies": {
    "essentia.js": "0.1.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "linkedom": "^0.18.13"
  }
}
